{
  "title": "PostgreSQL Monitoring - Production",
  "uid": "postgresql-production",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "PostgreSQL Status",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_up",
          "legendFormat": "PostgreSQL"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red"
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Active Connections",
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pg_stat_database_numbackends{datname!=\"template0\",datname!=\"template1\"})",
          "legendFormat": "Active Connections"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Database Size",
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 15,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_database_size_bytes",
          "legendFormat": "{{datname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Connection Usage %",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(pg_stat_database_numbackends{datname!=\"template0\",datname!=\"template1\"}) / pg_settings_max_connections",
          "legendFormat": "Connection Usage"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Transactions per Second",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pg_stat_database_xact_commit[5m]))",
          "legendFormat": "Commits/sec"
        },
        {
          "refId": "B",
          "expr": "sum(rate(pg_stat_database_xact_rollback[5m]))",
          "legendFormat": "Rollbacks/sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Cache Hit Ratio",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(pg_stat_database_blks_hit[5m])) / clamp_min(sum(rate(pg_stat_database_blks_hit[5m])) + sum(rate(pg_stat_database_blks_read[5m])), 1)",
          "legendFormat": "Cache Hit %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Deadlocks",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pg_stat_database_deadlocks[5m]))",
          "legendFormat": "Deadlocks/sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Database Activity",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pg_stat_database_tup_returned[5m]))",
          "legendFormat": "Rows Returned/sec"
        },
        {
          "refId": "B",
          "expr": "sum(rate(pg_stat_database_tup_fetched[5m]))",
          "legendFormat": "Rows Fetched/sec"
        },
        {
          "refId": "C",
          "expr": "sum(rate(pg_stat_database_tup_inserted[5m]))",
          "legendFormat": "Rows Inserted/sec"
        },
        {
          "refId": "D",
          "expr": "sum(rate(pg_stat_database_tup_updated[5m]))",
          "legendFormat": "Rows Updated/sec"
        },
        {
          "refId": "E",
          "expr": "sum(rate(pg_stat_database_tup_deleted[5m]))",
          "legendFormat": "Rows Deleted/sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Database Growth",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 38
      },
      "targets": [
        {
          "refId": "A",
          "expr": "deriv(pg_database_size_bytes[6h])",
          "legendFormat": "{{datname}} Growth Bytes/sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "WAL Generation",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 38
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(pg_stat_wal_wal_bytes[5m])",
          "legendFormat": "WAL Bytes/sec"
        },
        {
          "refId": "B",
          "expr": "rate(pg_stat_wal_wal_records[5m])",
          "legendFormat": "WAL Records/sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Checkpoint Activity",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 46
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(pg_stat_bgwriter_checkpoints_timed[5m])",
          "legendFormat": "Timed Checkpoints/sec"
        },
        {
          "refId": "B",
          "expr": "rate(pg_stat_bgwriter_checkpoints_req[5m])",
          "legendFormat": "Requested Checkpoints/sec"
        },
        {
          "refId": "C",
          "expr": "rate(pg_stat_bgwriter_buffers_checkpoint[5m])",
          "legendFormat": "Checkpoint Buffers/sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Autovacuum Activity",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 46
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pg_stat_user_tables_autovacuum_count[5m]))",
          "legendFormat": "Autovacuum/sec"
        },
        {
          "refId": "B",
          "expr": "sum(rate(pg_stat_user_tables_autoanalyze_count[5m]))",
          "legendFormat": "Autoanalyze/sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Long-running Queries",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 54
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_stat_activity_long_running_queries",
          "legendFormat": "Queries > 5 min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Waiting Sessions",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 54
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_stat_activity_waiting_sessions",
          "legendFormat": "Waiting Sessions"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        }
      }
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Blocked Queries",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 54
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_stat_activity_blocked_queries",
          "legendFormat": "Blocked Queries"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}