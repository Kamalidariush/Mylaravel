{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "id": 1,
      "title": "Redis Status",
      "type": "stat",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {"text": "DOWN"},
                "1": {"text": "UP"}
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "redis_up{job=\"redis\"}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "Memory Usage",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 9, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {"unit": "bytes"},
        "overrides": []
      },
      "targets": [
        {
          "expr": "redis_memory_used_bytes{job=\"redis\"}",
          "legendFormat": "Used",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Connected Clients",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 9, "x": 15, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": []
      },
      "targets": [
        {
          "expr": "redis_connected_clients{job=\"redis\"}",
          "legendFormat": "Clients",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Commands / sec",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 6},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {"unit": "ops"},
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(redis_commands_processed_total{job=\"redis\"}[5m])",
          "legendFormat": "Commands/sec",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Cache Hit Ratio",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 6},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 * redis_keyspace_hits_total{job=\"redis\"} / clamp_min(redis_keyspace_hits_total{job=\"redis\"} + redis_keyspace_misses_total{job=\"redis\"}, 1)",
          "legendFormat": "Hit Ratio",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Evicted Keys",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 6},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {"unit": "ops"},
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(redis_evicted_keys_total{job=\"redis\"}[5m])",
          "legendFormat": "Evictions/sec",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Expired Keys",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 12},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {"unit": "ops"},
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(redis_expired_keys_total{job=\"redis\"}[5m])",
          "legendFormat": "Expired/sec",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Network I/O",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 12},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {"unit": "Bps"},
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(redis_net_input_bytes_total{job=\"redis\"}[5m])",
          "legendFormat": "RX",
          "refId": "A"
        },
        {
          "expr": "rate(redis_net_output_bytes_total{job=\"redis\"}[5m])",
          "legendFormat": "TX",
          "refId": "B"
        }
      ]
    },
    {
      "id": 9,
      "title": "Blocked Clients",
      "type": "stat",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 18},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": []
      },
      "targets": [
        {
          "expr": "redis_blocked_clients{job=\"redis\"}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 10,
      "title": "Redis CPU",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 9, "x": 6, "y": 18},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {"unit": "percent"},
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(redis_cpu_sys_seconds_total{job=\"redis\"}[5m]) * 100",
          "legendFormat": "System",
          "refId": "A"
        },
        {
          "expr": "rate(redis_cpu_user_seconds_total{job=\"redis\"}[5m]) * 100",
          "legendFormat": "User",
          "refId": "B"
        }
      ]
    },
    {
      "id": 11,
      "title": "Redis Uptime",
      "type": "stat",
      "gridPos": {"h": 5, "w": 9, "x": 15, "y": 18},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {"unit": "s"},
        "overrides": []
      },
      "targets": [
        {
          "expr": "redis_uptime_in_seconds{job=\"redis\"}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      }
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": [
    "redis",
    "redis-exporter",
    "cache",
    "queue"
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "current": {}
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "title": "Redis - Production Monitoring",
  "uid": "redis-production"
}